# Configure an authorized deployment through an explicit owner-only file or
# the process environment. Never commit real credentials.

# Optional: select an ignored, non-secret runtime configuration.
# FORTIPAM_MCP_CONFIG=config/fortipam.local.json

# The runtime defaults to the 28-Tool read-only surface. Enable the six local,
# non-device V3.1 simulation Tools only with this exact explicit value.
# FORTIPAM_MCP_RUNTIME_PROFILE=lab-simulated

# Optional: select an ignored owner-only environment file (mode 600).
# FPA_HOME_LAB_FPA1_ENV_FILE=<path-to-fortinet_lab_secrets.local.env>

# Optional: use an explicit PEM CA instead of native system trust. TLS
# verification cannot be disabled.
# FPA_HOME_LAB_FPA1_CA_FILE=<path-to-lab-ca.pem>

# V2 CLI diagnostics use a separate, source-restricted, public-key identity.
# These files must be owner-only and must never be committed. The general API
# username, token, password, SSH agent, and global known_hosts are never reused.
# FPA_HOME_LAB_FPA1_MCP_CLI_SSH_HOST=<fortipam-management-address>
# FPA_HOME_LAB_FPA1_MCP_CLI_SSH_PORT=22
# FPA_HOME_LAB_FPA1_MCP_CLI_SSH_USERNAME=<dedicated-cli-username>
# FPA_HOME_LAB_FPA1_MCP_CLI_ROLE_NAME=<dedicated-cli-role>
# FPA_HOME_LAB_FPA1_MCP_CLI_TRUSTED_SOURCE=<docker-source-address>/32
# FPA_HOME_LAB_FPA1_MCP_CLI_SSH_IDENTITY_FILE=<path-to-private-key>
# FPA_HOME_LAB_FPA1_MCP_CLI_SSH_KNOWN_HOSTS_FILE=<path-to-pinned-known-hosts>
# FPA_HOME_LAB_FPA1_MCP_CLI_TIMEOUT_SECONDS=12
# FPA_HOME_LAB_FPA1_MCP_CLI_MAX_OUTPUT_BYTES=32768
# Default false. Set exactly true only after independently confirming the
# appliance emits the supported fixed (Press 'a' to accept): pre-login marker.
# FPA_HOME_LAB_FPA1_MCP_CLI_ACCEPT_PRE_LOGIN_BANNER=false

# The FortiPAM appliance client accepts its API token only in an Authorization
# header. There is no query-string token or TLS-bypass switch.

# Local-only Streamable HTTP example. This mode cannot bind a non-loopback
# listener and should not be used for shared access.
# FORTIPAM_MCP_HTTP_AUTH_MODE=none
# FORTIPAM_MCP_HTTP_HOST=127.0.0.1
# FORTIPAM_MCP_HTTP_PORT=8000
# FORTIPAM_MCP_HTTP_PATH=/mcp

# Remote HTTP settings should live in a separate ignored owner-only file.
# FORTIPAM_MCP_HTTP_ENV_FILE=<path-to-owner-only-http.env>
