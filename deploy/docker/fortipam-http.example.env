# Copy this file to an ignored owner-only deployment file and set mode 600.
# Never commit a real token, lab name, private address, or identity-provider ID.

FORTIPAM_MCP_HTTP_HOST=0.0.0.0
FORTIPAM_MCP_HTTP_PORT=8000
FORTIPAM_MCP_HTTP_PATH=/fpamcp

# Current single-operator internal WAF mode. Generate the password verifier with
# fortipam-mcp-local-oauth-hash and keep the resulting file outside the repo.
FORTIPAM_MCP_HTTP_AUTH_MODE=local_oauth
FORTIPAM_MCP_HTTP_PUBLIC_URL=https://mcp.example.com/fpamcp
FORTIPAM_MCP_HTTP_LOCAL_OAUTH_DB=/var/lib/fortipam-mcp/oauth.sqlite3
FORTIPAM_MCP_HTTP_LOCAL_OAUTH_USERNAME=replace-with-local-operator-name
FORTIPAM_MCP_HTTP_LOCAL_OAUTH_PASSWORD_HASH=replace-with-generated-scrypt-verifier
FORTIPAM_MCP_HTTP_ALLOWED_HOSTS=127.0.0.1:18039,mcp.example.com
FORTIPAM_MCP_HTTP_ALLOWED_ORIGINS=https://mcp.example.com

# Default is readonly (28 Tools). Enable the six local simulation Tools only
# for an isolated demonstration by setting exactly: lab-simulated
# FORTIPAM_MCP_RUNTIME_PROFILE=lab-simulated

# Optional V2.3 local diagnostic state. These variables are accepted only with
# oauth/local_oauth. Mount the HMAC key as a separate owner-only (0600) file and
# the state directory read/write; never place the key content in this file.
# FORTIPAM_MCP_DIAGNOSTIC_DB=/var/lib/fortipam-mcp/diagnostic.sqlite3
# FORTIPAM_MCP_DIAGNOSTIC_HMAC_KEY_FILE=/run/secrets/fortipam-diagnostic-hmac

# Optional V3.0 local controlled-operation approval state. V3.0 keeps the
# action registry empty and product adapter deny-all. Mount the database
# directory read/write and the raw 32-byte HMAC key read-only; never put the key
# content in this file.
# FORTIPAM_MCP_CONTROLLED_OPERATION_DB=/var/lib/fortipam-mcp/controlled-operation.sqlite3
# FORTIPAM_MCP_CONTROLLED_OPERATION_HMAC_KEY_FILE=/run/secrets/fortipam-controlled-operation-hmac

# V2 fixed CLI diagnostics. The private key and pinned known_hosts files are
# separate read-only mounts owned by container UID 10001; never place key
# contents in this environment file or reuse the FortiPAM API identity.
FPA_HOME_LAB_FPA1_MCP_CLI_SSH_HOST=fortipam.example.internal
FPA_HOME_LAB_FPA1_MCP_CLI_SSH_PORT=22
FPA_HOME_LAB_FPA1_MCP_CLI_SSH_USERNAME=fortipam-mcp-cli
FPA_HOME_LAB_FPA1_MCP_CLI_ROLE_NAME=fortipam-mcp-cli-role
FPA_HOME_LAB_FPA1_MCP_CLI_TRUSTED_SOURCE=192.0.2.10/32
FPA_HOME_LAB_FPA1_MCP_CLI_SSH_IDENTITY_FILE=/run/secrets/fortipam-cli-key
FPA_HOME_LAB_FPA1_MCP_CLI_SSH_KNOWN_HOSTS_FILE=/run/secrets/fortipam-cli-known-hosts
FPA_HOME_LAB_FPA1_MCP_CLI_TIMEOUT_SECONDS=12
FPA_HOME_LAB_FPA1_MCP_CLI_MAX_OUTPUT_BYTES=32768

# For a named lab/internal static credential instead, change AUTH_MODE to
# bearer and define a random FORTIPAM_MCP_HTTP_BEARER_TOKEN of 32+ characters.

# For enterprise/multi-user operation, change AUTH_MODE to oauth and define
# all external authorization-server settings below.
# FORTIPAM_MCP_HTTP_OAUTH_ISSUER=https://id.example.com
# FORTIPAM_MCP_HTTP_OAUTH_JWKS_URL=https://id.example.com/.well-known/jwks.json
# FORTIPAM_MCP_HTTP_OAUTH_AUDIENCE=https://mcp.example.com/fpamcp
# FORTIPAM_MCP_HTTP_OAUTH_REQUIRED_SCOPES=fortipam:read
# FORTIPAM_MCP_HTTP_OAUTH_ALGORITHMS=RS256
