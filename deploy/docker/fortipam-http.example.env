# Copy this file to an ignored owner-only deployment file and set mode 600.
# Never commit a real token, lab name, private address, or identity-provider ID.

FORTIPAM_MCP_HTTP_HOST=0.0.0.0
FORTIPAM_MCP_HTTP_PORT=8000
FORTIPAM_MCP_HTTP_PATH=/fpamcp

# Current single-operator internal WAF mode. Generate the password verifier with
# fortipam-mcp-local-oauth-hash and keep the resulting file outside the repo.
FORTIPAM_MCP_HTTP_AUTH_MODE=local_oauth
FORTIPAM_MCP_HTTP_PUBLIC_URL=https://mcp.example.com/fpamcp
FORTIPAM_MCP_HTTP_LOCAL_OAUTH_DB=/var/lib/fortipam-mcp/oauth.sqlite3
FORTIPAM_MCP_HTTP_LOCAL_OAUTH_USERNAME=replace-with-local-operator-name
FORTIPAM_MCP_HTTP_LOCAL_OAUTH_PASSWORD_HASH=replace-with-generated-scrypt-verifier
FORTIPAM_MCP_HTTP_ALLOWED_HOSTS=127.0.0.1:18039,mcp.example.com
FORTIPAM_MCP_HTTP_ALLOWED_ORIGINS=https://mcp.example.com

# Default is readonly (28 Tools). Enable the six local simulation Tools only
# for an isolated demonstration by setting exactly: lab-simulated
# FORTIPAM_MCP_RUNTIME_PROFILE=lab-simulated

# Optional V2.3 local diagnostic state. These variables are accepted only with
# oauth/local_oauth. Mount the HMAC key as a separate owner-only (0600) file and
# the state directory read/write; never place the key content in this file.
# FORTIPAM_MCP_DIAGNOSTIC_DB=/var/lib/fortipam-mcp/diagnostic.sqlite3
# FORTIPAM_MCP_DIAGNOSTIC_HMAC_KEY_FILE=/run/secrets/fortipam-diagnostic-hmac

# Optional V4 persistent Scheme Draft Authority. Configure both only with the
# exact v4-plan-only/local_oauth Host. The database directory is owner-only and
# writable; the independent raw HMAC key is owner-only and read-only. MCP and
# runtime startup never issue Draft references.
# FORTIPAM_MCP_V4_PLAN_SCHEME_DRAFT_AUTHORITY_DB=/var/lib/fortipam-mcp/scheme-drafts.sqlite3
# FORTIPAM_MCP_V4_PLAN_SCHEME_DRAFT_AUTHORITY_HMAC_KEY_FILE=/run/secrets/fortipam-scheme-draft-hmac

# Optional private one-shot Draft bootstrap. These values belong to the
# separate fortipam-mcp-v4-draft-bootstrap process, not the HTTP/MCP process.
# The exact input and new output files must be inside owner-only directories.
# FORTIPAM_MCP_V4_DRAFT_BOOTSTRAP_DATABASE=/var/lib/fortipam-mcp/scheme-drafts.sqlite3
# FORTIPAM_MCP_V4_DRAFT_BOOTSTRAP_HMAC_KEY_FILE=/run/secrets/fortipam-scheme-draft-hmac
# FORTIPAM_MCP_V4_DRAFT_BOOTSTRAP_AUTHORITY_REF=v4-persistent-scheme-draft-authority
# FORTIPAM_MCP_V4_DRAFT_BOOTSTRAP_INPUT=/run/fortipam-draft/input.json
# FORTIPAM_MCP_V4_DRAFT_BOOTSTRAP_OUTPUT=/run/fortipam-draft/output.json

# Optional lab-only combined Access Domain and Linux Secret onboarding.
# These settings are additional to a complete source-backed-onboarding Host and
# its owner-only binding/Authority files. Tool registration and final dispatch
# remain separate; one onboarding Gate controls internal Folder, ACL, Target
# create, and Secret actions. Target deletion is never enabled by this Gate.
# Launcher SSH settings are unnecessary when the protected Linux binding omits
# its optional Launcher; a declared Launcher still requires that exact transport.
# The exact Windows/RDP profile additionally requires the existing Secret Policy
# SSH and Recording Policy API read transports. They remain independently
# default-off and do not enable their mutable action Tools.
# Keep all state/key paths distinct. Secret values stay in SECRET_ENV_FILE and
# must never be placed in this example or the HTTP environment file.
# FORTIPAM_MCP_V4_ONBOARDING_EXECUTION_TOOLS_ENABLED=false
# FORTIPAM_MCP_V4_ONBOARDING_EXECUTION_ENABLED=false
# FORTIPAM_MCP_V4_ONBOARDING_EXECUTION_ACCESS_DOMAIN_AUTHORIZED_ENVIRONMENT_REF=replace-with-opaque-ref
# FORTIPAM_MCP_V4_ONBOARDING_EXECUTION_ACCESS_DOMAIN_AUTHORIZED_SCOPE_REF=replace-with-opaque-ref
# FORTIPAM_MCP_V4_SECRET_CREATE_LAB_AUTO_AUTHORITY_KEY_FILE=/run/secrets/fortipam-secret-lab-auto-authority
# FORTIPAM_MCP_V4_SECRET_CREATE_LAB_AUTO_AUTHORIZED_ENVIRONMENT_REF=replace-with-opaque-ref
# FORTIPAM_MCP_V4_SECRET_CREATE_LAB_AUTO_AUTHORIZED_SCOPE_REF=replace-with-opaque-ref
# FORTIPAM_MCP_V4_SECRET_CREATE_LAB_AUTO_CREDENTIAL_BINDINGS_FILE=/run/fortipam-private/credential-bindings.local.yaml
# FORTIPAM_MCP_V4_SECRET_CREATE_LAB_AUTO_SECRET_ENV_FILE=/run/secrets/fortipam-secret-material.env
# FORTIPAM_MCP_V4_SECRET_CREATE_LAB_AUTO_MATERIAL_BINDING_REF=replace-with-opaque-ref
# FORTIPAM_MCP_V4_SECRET_CREATE_LAB_AUTO_CREDENTIAL_BINDING_ID=replace-with-private-binding-id
# FORTIPAM_MCP_V4_SECRET_CREATE_LAB_AUTO_MATERIAL_STATE_DB=/var/lib/fortipam-mcp/secret-material.sqlite3
# FORTIPAM_MCP_V4_SECRET_CREATE_LAB_AUTO_MATERIAL_STATE_HMAC_KEY_FILE=/run/secrets/fortipam-secret-material-hmac
# FORTIPAM_MCP_V4_SECRET_CREATE_LAB_AUTO_EXECUTION_STATE_DB=/var/lib/fortipam-mcp/secret-execution.sqlite3
# FORTIPAM_MCP_V4_SECRET_CREATE_LAB_AUTO_EXECUTION_STATE_HMAC_KEY_FILE=/run/secrets/fortipam-secret-execution-hmac

# Optional BP008 approval-policy and same-requester Request Create laboratory
# path. This requires the exact source-backed-approval-and-observe Host plus its
# existing Draft/Reference Authority and Secret metadata API settings; the
# fixed Approval Profile readback reuses that API identity. The two Tool opt-ins
# and the Request dispatch Gate are
# independent and remain false by default. Keep the intent, claim, and HMAC key
# in distinct owner-only locations; a retained claim means do not retry.
# FORTIPAM_MCP_V4_PLAN_HOST_MODE=source-backed-approval-and-observe
# FORTIPAM_MCP_V4_PLAN_APPROVAL_AND_OBSERVE_BINDING_FILE=/run/fortipam-private/bp008-binding.json
# Optional existing-Request observer; binding activates only the fixed read Tool.
# FORTIPAM_MCP_V4_PLAN_SECRET_REQUEST_OBSERVATION_BINDING_FILE=/run/fortipam-private/request-observation-binding.json
# Defaults to api-bearer; bp005-requester-session opens a fresh exact-user session
# for each authorized read and verifies logout before publishing its result.
# FORTIPAM_MCP_V4_PLAN_SECRET_REQUEST_OBSERVATION_AUTHENTICATION_MODE=api-bearer
# FORTIPAM_MCP_V4_APPROVAL_AND_OBSERVE_EXECUTION_TOOLS_ENABLED=false
# FORTIPAM_MCP_V4_SECRET_REQUEST_CREATE_TOOLS_ENABLED=false
# FORTIPAM_MCP_V4_SECRET_AUDIT_SUMMARY_ENABLED=false
# FORTIPAM_MCP_V4_SECRET_REQUEST_CREATE_EXECUTION_ENABLED=false
# Defaults to api-bearer. The build-29 bp005-requester-session candidate reuses
# the active BP005 USERNAME and owner-only MATERIAL_DIRECTORY provider.
# FORTIPAM_MCP_V4_SECRET_REQUEST_CREATE_AUTHENTICATION_MODE=api-bearer
# FORTIPAM_MCP_V4_SECRET_REQUEST_CREATE_INTENT_BINDING_FILE=/run/fortipam-private/request-create-intent.json
# FORTIPAM_MCP_V4_SECRET_REQUEST_CREATE_DISPATCH_CLAIM_FILE=/var/lib/fortipam-mcp/request-create-claim.json
# FORTIPAM_MCP_V4_SECRET_REQUEST_CREATE_HMAC_KEY_FILE=/run/fortipam-request-create-key/hmac.hex
# FORTIPAM_MCP_V4_SECRET_REQUEST_CREATE_AUTHORIZED_ENVIRONMENT_REF=replace-with-opaque-ref
# FORTIPAM_MCP_V4_SECRET_REQUEST_CREATE_AUTHORIZED_SCOPE_REF=replace-with-opaque-ref

# Optional FortiPAM 7.0 Unix Password Changer clone recovery candidate. It
# reuses the independently enabled Secret Metadata API and Template SSH read
# bindings. The owner-only binding fixes one exact disposable clone name;
# the claim path is a distinct writable owner-only state file. Registration
# and the final DELETE Gate are independent and disabled by default.
# FORTIPAM_MCP_V4_PASSWORD_CHANGER_DELETE_700_ENABLED=false
# FORTIPAM_MCP_V4_PASSWORD_CHANGER_DELETE_700_EXECUTION_ENABLED=false
# FORTIPAM_MCP_V4_PASSWORD_CHANGER_DELETE_700_BINDING_FILE=/run/fortipam-private/password-changer-delete-binding.json
# FORTIPAM_MCP_V4_PASSWORD_CHANGER_DELETE_700_CLAIM_FILE=/var/lib/fortipam-mcp/password-changer-delete-claim.json

# Optional fixed FortiPAM 7.0 Unix Account Discovery laboratory candidate.
# The private binding fixes one disposable source name and existing Secret ID;
# the separate execution Gate and durable claim default closed.
# FORTIPAM_MCP_V4_DISCOVERY_UNIX_700_ENABLED=false
# FORTIPAM_MCP_V4_DISCOVERY_UNIX_700_EXECUTION_ENABLED=false
# FORTIPAM_MCP_V4_DISCOVERY_UNIX_700_BINDING_FILE=/run/fortipam-private/discovery-unix-binding.json
# FORTIPAM_MCP_V4_DISCOVERY_UNIX_700_CLAIM_FILE=/var/lib/fortipam-mcp/discovery-unix-claim.json
# FORTIPAM_MCP_V4_DISCOVERY_REVIEW_700_ENABLED=false
# FORTIPAM_MCP_V4_DISCOVERY_REVIEW_700_BINDING_FILE=/run/fortipam-private/discovery-unix-binding.json

# Optional private one-shot C2 Reference grant bootstrap. These variables are
# for fortipam-mcp-v4-reference-bootstrap, not the HTTP/MCP process.
# FORTIPAM_MCP_V4_REFERENCE_BOOTSTRAP_DATABASE=/var/lib/fortipam-mcp/references.sqlite3
# FORTIPAM_MCP_V4_REFERENCE_BOOTSTRAP_HMAC_KEY_FILE=/run/secrets/fortipam-reference-hmac
# FORTIPAM_MCP_V4_REFERENCE_BOOTSTRAP_AUTHORITY_REF=v4-persistent-reference-authority
# FORTIPAM_MCP_V4_REFERENCE_BOOTSTRAP_INPUT=/run/fortipam-reference/input.json
# FORTIPAM_MCP_V4_REFERENCE_BOOTSTRAP_OUTPUT=/run/fortipam-reference/output.json

# Optional concrete local planning checkpoint Authority. Configure all three
# with separate owner-only state/key domains. It detects planning DB rollback,
# but the public external-checkpoint blocker remains until this state is
# independently deployed and accepted outside the planning-store failure domain.
# FORTIPAM_MCP_V4_PLAN_CHECKPOINT_AUTHORITY_DB=/var/lib/fortipam-checkpoint/checkpoint.sqlite3
# FORTIPAM_MCP_V4_PLAN_CHECKPOINT_AUTHORITY_HMAC_KEY_FILE=/run/secrets/fortipam-checkpoint-hmac
# FORTIPAM_MCP_V4_PLAN_CHECKPOINT_STORE_REF=v4-planning-store-production

# Process-separated alternative to the local Host-owned checkpoint Authority.
# Run fortipam-mcp-v4-checkpoint with the four service variables, then bind the
# Host with the socket, matching Authority ref, and the store ref above. Do not
# configure this together with the two local Authority state variables.
# FORTIPAM_MCP_V4_CHECKPOINT_DATABASE=/var/lib/fortipam-checkpoint/checkpoint.sqlite3
# FORTIPAM_MCP_V4_CHECKPOINT_HMAC_KEY_FILE=/run/secrets/fortipam-checkpoint-hmac
# FORTIPAM_MCP_V4_CHECKPOINT_AUTHORITY_REF=v4-planning-checkpoint-production
# FORTIPAM_MCP_V4_CHECKPOINT_SOCKET=/run/fortipam-checkpoint/checkpoint.sock
# FORTIPAM_MCP_V4_PLAN_CHECKPOINT_SIDECAR_SOCKET=/run/fortipam-checkpoint/checkpoint.sock
# FORTIPAM_MCP_V4_PLAN_CHECKPOINT_SIDECAR_AUTHORITY_REF=v4-planning-checkpoint-production

# Optional V4 HA reconciliation Tool. It remains disabled unless all three
# variables below are set and the runtime profile is v4-plan-only or
# v4-controlled. Both JSON files are value-free, owner-only (0600), and mounted
# read-only from separate 0700 directories; configured booleans are not lab
# permission evidence.
# FORTIPAM_MCP_V4_HA_RECONCILIATION_ENABLED=false
# FORTIPAM_MCP_HA_RECONCILIATION_PREREQUISITES_FILE=/run/fortipam-ha/prerequisites.json
# FORTIPAM_MCP_HA_RECONCILIATION_QUERY_PERMISSION_FILE=/run/fortipam-ha-permission/query-permission.json

# Optional V3.0 local controlled-operation approval state. V3.0 keeps the
# action registry empty and product adapter deny-all. Mount the database
# directory read/write and the raw 32-byte HMAC key read-only; never put the key
# content in this file.
# FORTIPAM_MCP_CONTROLLED_OPERATION_DB=/var/lib/fortipam-mcp/controlled-operation.sqlite3
# FORTIPAM_MCP_CONTROLLED_OPERATION_HMAC_KEY_FILE=/run/secrets/fortipam-controlled-operation-hmac

# V2 fixed CLI diagnostics. The private key and pinned known_hosts files are
# separate read-only mounts owned by container UID 10001; never place key
# contents in this environment file or reuse the FortiPAM API identity.
FPA_HOME_LAB_FPA1_MCP_CLI_SSH_HOST=fortipam.example.internal
FPA_HOME_LAB_FPA1_MCP_CLI_SSH_PORT=22
FPA_HOME_LAB_FPA1_MCP_CLI_SSH_USERNAME=fortipam-mcp-cli
FPA_HOME_LAB_FPA1_MCP_CLI_ROLE_NAME=fortipam-mcp-cli-role
FPA_HOME_LAB_FPA1_MCP_CLI_TRUSTED_SOURCE=192.0.2.10/32
FPA_HOME_LAB_FPA1_MCP_CLI_SSH_IDENTITY_FILE=/run/secrets/fortipam-cli-key
FPA_HOME_LAB_FPA1_MCP_CLI_SSH_KNOWN_HOSTS_FILE=/run/secrets/fortipam-cli-known-hosts
FPA_HOME_LAB_FPA1_MCP_CLI_TIMEOUT_SECONDS=12
FPA_HOME_LAB_FPA1_MCP_CLI_MAX_OUTPUT_BYTES=32768

# For a named lab/internal static credential instead, change AUTH_MODE to
# bearer and define a random FORTIPAM_MCP_HTTP_BEARER_TOKEN of 32+ characters.

# For enterprise/multi-user operation, change AUTH_MODE to oauth and define
# all external authorization-server settings below.
# FORTIPAM_MCP_HTTP_OAUTH_ISSUER=https://id.example.com
# FORTIPAM_MCP_HTTP_OAUTH_JWKS_URL=https://id.example.com/.well-known/jwks.json
# FORTIPAM_MCP_HTTP_OAUTH_AUDIENCE=https://mcp.example.com/fpamcp
# FORTIPAM_MCP_HTTP_OAUTH_REQUIRED_SCOPES=fortipam:read
# FORTIPAM_MCP_HTTP_OAUTH_ALGORITHMS=RS256
# Optional BP006 fixed SSH fallback; no automatic REST-to-SSH failover.
# Enabling requires the reviewed reason: rest-field-replacement-20260915.
FPA_HOME_LAB_FPA1_V4_SECRET_SESSION_CONTROLS_ENABLED=false
FPA_HOME_LAB_FPA1_V4_SECRET_SESSION_CONTROLS_API_UNAVAILABLE_REASON=
FPA_HOME_LAB_FPA1_V4_SECRET_SESSION_CONTROLS_SSH_HOST=
FPA_HOME_LAB_FPA1_V4_SECRET_SESSION_CONTROLS_SSH_PORT=22
FPA_HOME_LAB_FPA1_V4_SECRET_SESSION_CONTROLS_SSH_USERNAME=
FPA_HOME_LAB_FPA1_V4_SECRET_SESSION_CONTROLS_SSH_PASSWORD_FILE=
FPA_HOME_LAB_FPA1_V4_SECRET_SESSION_CONTROLS_SSH_KNOWN_HOSTS_FILE=
FPA_HOME_LAB_FPA1_V4_SECRET_SESSION_CONTROLS_SSH_TIMEOUT_SECONDS=15

# Optional BP007 existing-Web service candidate; default off, no automatic fallback.
# The SSH host must match the metadata REST URL hostname.
# The existing onboarding execution Gate remains separately required.
FPA_HOME_LAB_FPA1_V4_WEB_SECRET_SERVICE_ENABLED=false
FPA_HOME_LAB_FPA1_V4_WEB_SECRET_SERVICE_API_UNAVAILABLE_REASON=
FPA_HOME_LAB_FPA1_V4_WEB_SECRET_SERVICE_SSH_HOST=
FPA_HOME_LAB_FPA1_V4_WEB_SECRET_SERVICE_SSH_PORT=22
FPA_HOME_LAB_FPA1_V4_WEB_SECRET_SERVICE_SSH_USERNAME=
FPA_HOME_LAB_FPA1_V4_WEB_SECRET_SERVICE_SSH_PASSWORD_FILE=
FPA_HOME_LAB_FPA1_V4_WEB_SECRET_SERVICE_SSH_KNOWN_HOSTS_FILE=
FPA_HOME_LAB_FPA1_V4_WEB_SECRET_SERVICE_SSH_TIMEOUT_SECONDS=15
FPA_HOME_LAB_FPA1_V4_WEB_SECRET_SERVICE_AUTHORITY_KEY_FILE=
FPA_HOME_LAB_FPA1_V4_WEB_SECRET_SERVICE_EXECUTION_STATE_DB=
FPA_HOME_LAB_FPA1_V4_WEB_SECRET_SERVICE_EXECUTION_STATE_HMAC_KEY_FILE=
FPA_HOME_LAB_FPA1_V4_WEB_SECRET_SERVICE_AUTHORIZED_ENVIRONMENT_REF=
FPA_HOME_LAB_FPA1_V4_WEB_SECRET_SERVICE_AUTHORIZED_SCOPE_REF=
# Optional 7.0 build-29 collector Owner session; never enables the execution Gate.
# Only use with the exact WinRM collector candidate and source-backed-secret-onboarding.
FORTIPAM_MCP_V4_SECRET_CREATE_LAB_AUTO_OWNER_SESSION_ENABLED=false
# FORTIPAM_MCP_V4_SECRET_CREATE_LAB_AUTO_OWNER_LOGIN_ENV_FILE=/private/central-lab.env
# FORTIPAM_MCP_V4_SECRET_CREATE_LAB_AUTO_OWNER_USERNAME_VARIABLE=EXAMPLE_GUI_USERNAME
# FORTIPAM_MCP_V4_SECRET_CREATE_LAB_AUTO_OWNER_PASSWORD_VARIABLE=EXAMPLE_GUI_PASSWORD

# Optional build-29 fixed Web event subscription candidate. Both flags default
# false. Recipient profiles require a distinct qualified lab identity/fixture,
# recipient authority and delivery observation; configuration grants none.
# FORTIPAM_MCP_V4_SECRET_EVENT_SUBSCRIPTION_700_ENABLED=false
# FORTIPAM_MCP_V4_SECRET_EVENT_SUBSCRIPTION_700_EXECUTION_ENABLED=false
# FORTIPAM_MCP_V4_SECRET_EVENT_SUBSCRIPTION_700_AUTHENTICATION_PROFILE=bp005-requester-session
# Defaults to unset, preserving the accepted empty-email profile and old claims.
# The locally qualified bound-lab-recipient option requires an exact owner-only
# 0600 file; never place a real address in this environment file or Tool inputs.
# FORTIPAM_MCP_V4_SECRET_EVENT_SUBSCRIPTION_700_EMAIL_PROFILE=unset
# FORTIPAM_MCP_V4_SECRET_EVENT_SUBSCRIPTION_700_RECIPIENT_BINDING_FILE=/run/fortipam-private/notification-recipient.json
